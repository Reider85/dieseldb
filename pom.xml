        <!-- ============ ALL: release gate (aggregate) ============ -->
        <profile>
            <id>all</id>
            <properties>
                <surefire.groups>smoke, query, index, query-full, storage, concurrency, network</surefire.groups>
                <surefire.excludedGroups>large,perf,flaky</surefire.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes combine.self="override"/>
                            <groups>${surefire.groups}</groups>
                            <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                            <!-- TESTS-7 (attempt 6 topology): forkCount=1,
                                 reuseForks=FALSE - fresh JVM PER CLASS and NO
                                 second hot JVM on the machine.
                                 History: attempt 1 (2 forks x parallel 4 = 8-way
                                 oversubscription) - 34.5 min + starvation reds;
                                 attempt 2 (1 fork x 4, -Xmx1g) - 18.4 min but
                                 shared-heap/global-state reds (JMX, sysprops,
                                 GC-polluted µs proofs); attempt 3 (1 fork, 2g)
                                 - 24.9 min, yet another victim family each run;
                                 attempt 4 (2 forks, reuseForks=false) - 26 min,
                                 3106/3107 green, sole red = CopyAlgorithmTest
                                 barrier microbench (isolated-green); attempt 5 -
                                 1/3107 again, DeadlockOverheadTest microbench
                                 (isolated-green family). Root cause of the
                                 residual: both microbenchmark victims
                                 historically ran at forkCount=1 under
                                 ZERO neighbor-JVM contention (old
                                 concurrency/perf profiles), forkCount=2 always
                                 gave them a hot second JVM.
                                 reuseForks=false is the load-bearing fix
                                 (clean heap, no cross-class JMX/sysprop/static
                                 state per class - the network/concurrency
                                 isolation model); forkCount=1 removes the
                                 neighbor contention. -Xmx2g per short-lived
                                 fork. <parallel>/<threadCountClasses>
                                 intentionally dropped: each JVM hosts a single
                                 class. -->
                            <forkCount>1</forkCount>
                            <reuseForks>false</reuseForks>
                            <argLine>-Xmx2g --add-modules=jdk.incubator.vector</argLine>
                            <systemPropertyVariables>
                                <!-- TESTS-7: both keys mirror the network profile.
                                     diesel.runAllTestsSample opens AllTestsSampleTest's
                                     class gate - without it the class was silently
                                     DISABLED in '-P all' (its @Tag("network") matched,
                                     but @EnabledIfSystemProperty did not).
                                     diesel.largeTests stays the root-property
                                     passthrough (false): @LargeTest methods were
                                     disabled in the old fast/core/concurrency runs
                                     of the all-tests loop too - parity kept. -->
                                <diesel.largeTests>${diesel.largeTests}</diesel.largeTests>
                                <diesel.runAllTestsSample>true</diesel.runAllTestsSample>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ============ FLAKY: quarantine opt-in (TESTS-5) ============
             Runs ONLY the tests tagged @Tag("flaky") — the documented
             pre-existing/environmental flakes quarantined from every gate
             (surefire.excludedGroups now ends in ",flaky" everywhere).
             The systemPropertyVariables below are what makes the quarantined
             methods actually enabled in this profile:
               diesel.runFlaky=true     -> @EnabledIfSystemProperty gate opens
               diesel.largeTests=true   -> @LargeTest (1M-row benchmark) gate opens
               junit.jupiter...parallel.enabled=false -> the heavy tests run one
                   after another instead of competing for CPU.
             Engine storage stays at the config.properties default (csv) —
             FlusherTest's 50k-insert loop is O(n²) on full-file rewrites and
             takes hours under jsonl (observed: 14 min for the first 5k rows).
             The JSONL-quarantined benchmark has its own profile below. -->
        <profile>
            <id>flaky</id>
            <properties>
                <test.heap>1g</test.heap>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes combine.self="override"/>
                            <groups>flaky</groups>
                            <forkCount>1</forkCount>
                            <reuseForks>true</reuseForks>
                            <argLine>-Xmx1g --add-modules=jdk.incubator.vector</argLine>
                            <systemPropertyVariables>
                                <diesel.largeTests>true</diesel.largeTests>
                                <diesel.runFlaky>true</diesel.runFlaky>
                                <junit.jupiter.execution.parallel.enabled>false</junit.jupiter.execution.parallel.enabled>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ============ FLAKY-JSONL: the quarantined 1M-row benchmark ============
             JsonlStorageAdvancedTest carries @StorageType("jsonl"), and
             StorageTypeCondition resolves diesel.storage.type -> config.properties
             (csv) -> the class is disabled in EVERY other profile (this is also
             why it no longer runs in gates at all). This profile enables it via
             diesel.storage.type=jsonl; the two engine-level quarantined tests are
             excluded here (they would be flaky-tagged and slow under jsonl) —
             they belong to the 'flaky' profile above. -->
        <profile>
            <id>flaky-jsonl</id>
            <properties>
                <test.heap>1g</test.heap>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes combine.self="override">
                                <exclude>diesel/FlusherTest.java</exclude>
                                <exclude>diesel/wal/GroupCommitThroughputTest.java</exclude>
                            </excludes>
                            <groups>flaky</groups>
                            <forkCount>1</forkCount>
                            <reuseForks>true</reuseForks>
                            <argLine>-Xmx1g --add-modules=jdk.incubator.vector</argLine>
                            <systemPropertyVariables>
                                <diesel.largeTests>true</diesel.largeTests>
                                <diesel.runFlaky>true</diesel.runFlaky>
                                <diesel.storage.type>jsonl</diesel.storage.type>
                                <junit.jupiter.execution.parallel.enabled>false</junit.jupiter.execution.parallel.enabled>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ============ TIMING-QUICK: fast timing gate (TESTS-6) ============
             Runs ONLY the tests tagged @Tag("timing") (~3-5 min instead of the
             full large profile's 10-30 min). Self-contained like the 'flaky'
             profile - hardcoded <groups>, no CLI -D flags (profile config
             overrides user properties, and -DexcludedGroups=large would
             exclude exactly the @LargeTest/@Tag("large") baseline rows we
             need). NO <excludedGroups> at all: with it absent, JUnit's
             exclude-tags filter is empty, so methods carrying both
             @Tag("timing") and @Tag("large") (VacuumTest, the 600x600 joins)
             still run.
             Conditions mirror the 'large' profile (4g heap, one fork per
             class) so overlap rows stay comparable with timing-full, plus
             class-parallelism OFF for stable per-testcase measurements
             (the timing/timing.md baseline era predated TESTS-3 parallelism).
             diesel.largeTests opens the @LargeTest gate,
             diesel.runAllTestsSample opens AllTestsSampleTest's class gate. -->
        <profile>
            <id>timing-quick</id>
            <properties>
                <diesel.largeTests>true</diesel.largeTests>
                <test.heap>4g</test.heap>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes combine.self="override"/>
                            <groups>timing</groups>
                            <forkCount>1</forkCount>
                            <reuseForks>false</reuseForks>
                            <argLine>-Xmx4g --add-modules=jdk.incubator.vector</argLine>
                            <systemPropertyVariables>
                                <diesel.largeTests>true</diesel.largeTests>
                                <diesel.runAllTestsSample>true</diesel.runAllTestsSample>
                                <junit.jupiter.execution.parallel.enabled>false</junit.jupiter.execution.parallel.enabled>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

